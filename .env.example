# Database & Queue (Use 'db' and 'redis' as hostnames inside Docker)
DATABASE_URL=postgresql://postgres:password@db:5432/envoy_db
REDIS_URL=redis://:changeme@redis:6379/0

# LLM Parser (Groq API — get your key at https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Security & Admin UI
# Generate a key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
COOKIE_ENCRYPTION_KEY=replace-with-a-generated-fernet-key
ADMIN_PASSWORD=replace-with-a-strong-password

# Playwright (True in production, False for local visual debugging)
PLAYWRIGHT_HEADLESS=true

# Optional Telegram Alerts (Leave blank to disable)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
